    <Geometry x:Key="Glyph.Back">M15,4.5 L7.5,12 L15,19.5</Geometry>
    <Geometry x:Key="Glyph.Forward">M9,4.5 L16.5,12 L9,19.5</Geometry>
    <Geometry x:Key="Glyph.Restart">M4.5,12 A7.5,7.5 0 1 0 7,6.4 M4,3.5 V8 H8.5</Geometry>
    <Geometry x:Key="Glyph.Map">M3,12 A5,5 0 1 1 13,12 A5,5 0 1 1 3,12 Z M14,6.5 A3.5,3.5 0 1 1 21,6.5 A3.5,3.5 0 1 1 14,6.5 Z M14.5,17 A3,3 0 1 1 20.5,17 A3,3 0 1 1 14.5,17 Z</Geometry>
    <Geometry x:Key="Glyph.Eye">M2,12 C4.5,7.5 8,5.5 12,5.5 C16,5.5 19.5,7.5 22,12 C19.5,16.5 16,18.5 12,18.5 C8,18.5 4.5,16.5 2,12 Z M8.8,12 A3.2,3.2 0 1 0 15.2,12 A3.2,3.2 0 1 0 8.8,12 Z</Geometry>
    <Geometry x:Key="Glyph.Stack">M3,6 H21 V9.5 H3 Z M3,11 H16 V14.5 H3 Z M3,16 H11 V19.5 H3 Z</Geometry>
    <Geometry x:Key="Glyph.Trash">M4,6 H20 M9.5,6 V4 H14.5 V6 M6,6 L7,20.5 H17 L18,6</Geometry>

    <LinearGradientBrush x:Key="Br.GlyphFolder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD9CCFF" Offset="0"/>
        <GradientStop Color="#FFA78BFA" Offset="0.55"/>
        <GradientStop Color="#FF8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Br.GlyphFile" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF4F2F8" Offset="0"/>
        <GradientStop Color="#FFC9C1DC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Br.GlyphOthers" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE4DBFA" Offset="0"/>
        <GradientStop Color="#FFA79FBC" Offset="1"/>
    </LinearGradientBrush>


    <!-- ══════════════ Botones extra ══════════════ -->

    <!-- Enlace de texto: migas de pan, «Seleccionar todo»… -->
    <Style x:Key="BtnLink" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón cuadrado con icono (atrás / adelante) -->
    <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource Br.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
    </Style>

    <!-- Acción destructiva principal: desinstalar, mover a la papelera -->
    <Style x:Key="BtnDestructive" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{StaticResource R.Control}" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFF26D80" Offset="0"/>
                                <GradientStop Color="#FFC9304A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF2556A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFB02A40"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Casilla ══════════════ -->

    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="17" Height="17" CornerRadius="5"
                            Background="{StaticResource Br.Well}"
                            BorderBrush="{StaticResource Br.StrokeStrong}" BorderThickness="1.2">
                        <Path x:Name="Mark" Data="M5,12.5 L10,17 L19,7.5" Stroke="White" StrokeThickness="3.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="Uniform" Width="9" Height="9" Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Br.AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Br.AccentGradient}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Br.AccentBright}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Lista plana ══════════════ -->

    <Style x:Key="FlatList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                        Padding="10,7" Margin="0,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.SurfaceHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Lista en la que se elige una fila. Va aparte de FlatList porque sus
        filas sí reciben el foco: WPF sólo marca como seleccionado lo que puede
        enfocar, así que con Focusable="False" el clic no selecciona nada.
    -->
    <Style x:Key="SelectList" TargetType="ListBox" BasedOn="{StaticResource FlatList}">
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="True"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                        Padding="10,7" Margin="0,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.SurfaceHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentTint}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Opción de unidad (pantalla de inicio de la Lupa) ══════════════ -->

    <Style x:Key="SourceOption" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="LensSource"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Br.Option}" BorderBrush="{StaticResource Br.Stroke}"
                            BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,0,0,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Br.AccentDeep}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentTintStrong}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Br.AccentBright}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ══════════════ Menú contextual oscuro ══════════════ -->

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Br.SurfaceRaised}" BorderBrush="{StaticResource Br.StrokeStrong}"
                            BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="210">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="11,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentTintStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource Br.Stroke}" Margin="8,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Geometry x:Key="Glyph.Open">M14,3.5 H20.5 V10 M20.5,3.5 L11,13 M18,14 V19 C18,19.8 17.3,20.5 16.5,20.5 H5 C4.2,20.5 3.5,19.8 3.5,19 V7.5 C3.5,6.7 4.2,6 5,6 H10</Geometry>
    <Geometry x:Key="Glyph.OpenWith">M4,5 H20 V19 H4 Z M4,9 H20 M8,13 H16 M8,16 H13</Geometry>
    <Geometry x:Key="Glyph.Folder.Line">M3,7 C3,5.9 3.9,5 5,5 H9.2 L11.2,7 H19 C20.1,7 21,7.9 21,9 V17 C21,18.1 20.1,19 19,19 H5 C3.9,19 3,18.1 3,17 Z</Geometry>
    <Geometry x:Key="Glyph.Check">M5,12.5 L10,17 L19,7.5</Geometry>
    <Geometry x:Key="Glyph.Broom">M19.5,3.5 L12.5,10.5 M9.5,9 L15,14.5 L13.5,16 C12,19 8.5,21 4,20.5 C3.5,16 5.5,12.5 8,11 Z M7,15.5 L5.5,18.5 M10,17 L8.8,19.8</Geometry>
    <Geometry x:Key="Glyph.Close">M6,6 L18,18 M18,6 L6,18</Geometry>


    <!-- ══════════════ Interruptor (activar / desactivar) ══════════════ -->

    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="13" Background="{StaticResource Br.SwitchOff}"
                                BorderBrush="{StaticResource Br.StrokeStrong}" BorderThickness="1"/>
                        <Ellipse x:Name="Knob" Width="18" Height="18" Margin="4,0" Fill="{StaticResource Br.SwitchKnobOff}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.4" Color="Black"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Br.AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Br.AccentGradient}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Br.AccentBright}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmento de un control segmentado (filtros): sin óvalos, como en macOS -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="TweakFilter"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="7" Padding="12,6" Margin="2" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Contenedor del control segmentado -->
    <Style x:Key="Segmented" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Br.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Geometry x:Key="Icon.Pc">M3,4 H21 V16 H3 Z M1,18 H23 V20 H1 Z M9,7 H15 V13 H9 Z</Geometry>
    <Geometry x:Key="Icon.Display">M2.5,3.5 H21.5 V16.5 H2.5 Z M10,16.5 H14 V19.5 H10 Z M6.5,19.5 H17.5 V21 H6.5 Z</Geometry>
    <Geometry x:Key="Glyph.Sun">M8,12 A4,4 0 1 1 16,12 A4,4 0 1 1 8,12 Z M11,1.5 H13 V4.5 H11 Z M11,19.5 H13 V22.5 H11 Z M1.5,11 H4.5 V13 H1.5 Z M19.5,11 H22.5 V13 H19.5 Z M4.2,5.6 L5.6,4.2 L7.7,6.3 L6.3,7.7 Z M16.3,17.7 L17.7,16.3 L19.8,18.4 L18.4,19.8 Z M16.3,6.3 L18.4,4.2 L19.8,5.6 L17.7,7.7 Z M4.2,18.4 L6.3,16.3 L7.7,17.7 L5.6,19.8 Z</Geometry>
    <Geometry x:Key="Glyph.Moon">M20.5,14.5 C19.3,15.1 18,15.4 16.6,15.4 C11.9,15.4 8.1,11.6 8.1,6.9 C8.1,5.5 8.4,4.2 9,3 C5.3,4.2 2.6,7.7 2.6,11.8 C2.6,17 6.8,21.2 12,21.2 C16.1,21.2 19.6,18.5 20.5,14.5 Z</Geometry>
    <Geometry x:Key="Icon.Optimize">M13.5,2 L4.5,13.5 H11 L10,22 L19.5,10 H13 Z</Geometry>
    <Geometry x:Key="Icon.Apps">M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,17.5 A3.5,3.5 0 1 1 21,17.5 A3.5,3.5 0 1 1 14,17.5 Z</Geometry>
    <Geometry x:Key="Glyph.Info">M12,2.5 A9.5,9.5 0 1 1 11.99,2.5 Z M11,10.5 H13 V17 H11 Z M11,7 H13 V9 H11 Z</Geometry>

    <!-- ══════════════ Navegación lateral ══════════════ -->

    <!--
        Cada entrada es un RadioButton: la exclusión mutua ya viene resuelta por
        el propio control, y a diferencia de un TabItem la vista sigue siendo
        XAML normal, con nombres accesibles desde el code-behind.
    -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="ShellNav"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Margin="10,1" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icono dentro de una baldosa con borde, como en Ajustes de macOS -->
                            <Border x:Name="IconTile" Width="28" Height="28" CornerRadius="8"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{StaticResource Br.Surface}"
                                    BorderBrush="{StaticResource Br.StrokeStrong}" BorderThickness="1">
                                <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                      Fill="{StaticResource Br.TextSecondary}"
                                      Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.NavHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Br.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.SurfaceHover}"/>
                            <Setter TargetName="IconTile" Property="Background" Value="{StaticResource Br.AccentGradient}"/>
                            <Setter TargetName="IconTile" Property="BorderBrush" Value="{StaticResource Br.AccentBright}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="#FFFFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Píldoras / etiquetas ══════════════ -->

    <!-- Etiqueta: rectángulo suave sin contorno, al estilo de las etiquetas de macOS -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Br.AccentTint}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Br.AccentBright}"/>
    </Style>

    <!-- ══════════════ Entrada de texto ══════════════ -->

    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Br.Well}"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Br.AccentBright}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Br.AccentDeep}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Br.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Tooltip ══════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Br.SurfaceRaised}"
                            BorderBrush="{StaticResource Br.StrokeStrong}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
