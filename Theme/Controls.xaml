<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Radios de esquina: continuos y generosos, como en macOS -->
    <CornerRadius x:Key="R.Card">14</CornerRadius>
    <CornerRadius x:Key="R.Control">9</CornerRadius>
    <CornerRadius x:Key="R.Pill">3</CornerRadius>

    <!-- ══════════════ Superficies ══════════════ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Br.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Card}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Tarjeta protagonista: recibe el resplandor morado -->
    <Style x:Key="CardHero" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource Br.HeroGlow}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.StrokeStrong}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <!-- Hueco hundido: gráficos, tablas, bloques de datos dentro de una tarjeta -->
    <Style x:Key="Well" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Br.Well}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.StrokeSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Control}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Br.StrokeSoft}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ══════════════ Botones ══════════════ -->

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Br.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.StrokeStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.SurfaceHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Br.AccentDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentTint}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource Br.AccentGradient}"
                            CornerRadius="{StaticResource R.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentDeep}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
    </Style>

    <!-- Acción destructiva discreta (finalizar proceso) -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextTertiary}"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26F2556A"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Br.Critical}"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.Critical}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botones del chrome de ventana -->
    <Style x:Key="BtnCaption" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnCaptionClose" TargetType="Button" BasedOn="{StaticResource BtnCaption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE0364B"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Barras de progreso ══════════════ -->

    <Style x:Key="Meter" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{StaticResource Br.Track}"/>
        <Setter Property="Foreground" Value="{StaticResource Br.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource R.Pill}"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource R.Pill}"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MeterLarge" TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
        <Setter Property="Height" Value="10"/>
    </Style>

    <!-- ══════════════ Scrollbar ══════════════ -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{StaticResource Br.ScrollThumb}" CornerRadius="3" Margin="3,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Iconografía ══════════════ -->
    <!--
        Dibujadas a mano sobre una retícula de 24 px en vez de usar Segoe MDL2:
        así el juego completo comparte grosor, redondeo y densidad, que es lo
        que hace que un icono se lea como parte de un sistema y no como un
        pictograma prestado.
    -->
    <Geometry x:Key="Icon.Brand">M4,13.5 H8 V21 H4 Z M10,7.5 H14 V21 H10 Z M16,3 H20 V21 H16 Z</Geometry>
    <Geometry x:Key="Icon.Overview">M3,3 H10.2 V10.2 H3 Z M13.8,3 H21 V10.2 H13.8 Z M3,13.8 H10.2 V21 H3 Z M13.8,13.8 H21 V21 H13.8 Z</Geometry>
    <Geometry x:Key="Icon.Memory">M5,7 H19 V17 H5 Z M8,3.5 H10 V7 H8 Z M13,3.5 H15 V7 H13 Z M8,17 H10 V20.5 H8 Z M13,17 H15 V20.5 H13 Z</Geometry>
    <Geometry x:Key="Icon.Storage">M3,5 H21 V10.5 H3 Z M3,13.5 H21 V19 H3 Z</Geometry>
    <Geometry x:Key="Icon.Processes">M3.5,5 H20.5 V7.2 H3.5 Z M3.5,10.9 H16 V13.1 H3.5 Z M3.5,16.8 H11.5 V19 H3.5 Z</Geometry>
    <Geometry x:Key="Icon.Evidence">M12,2 L20,5.2 V11 C20,16.2 16.4,20.2 12,22 C7.6,20.2 4,16.2 4,11 V5.2 Z</Geometry>
    <Geometry x:Key="Icon.Tools">M3,6.4 H21 V8.6 H3 Z M3,15.4 H21 V17.6 H3 Z M7.5,3.5 H9.7 V11.5 H7.5 Z M14.3,12.5 H16.5 V20.5 H14.3 Z</Geometry>


    <Geometry x:Key="Icon.Lens">M3,10.5 A7.5,7.5 0 1 1 18,10.5 A7.5,7.5 0 1 1 3,10.5 Z M6,10.5 A4.5,4.5 0 1 0 15,10.5 A4.5,4.5 0 1 0 6,10.5 Z M15.4,17.5 L17.5,15.4 L22,19.9 L19.9,22 Z</Geometry>

    <!-- ══════════════ Glifos de la Lupa ══════════════ -->
    <Geometry x:Key="Glyph.Folder">M2,6.2 C2,5 3,4 4.2,4 H9 C9.5,4 9.9,4.2 10.2,4.5 L12,6.5 H19.8 C21,6.5 22,7.5 22,8.7 V17.8 C22,19 21,20 19.8,20 H4.2 C3,20 2,19 2,17.8 Z</Geometry>
    <Geometry x:Key="Glyph.File">M6.5,2.5 H13.5 L19,8 V19.5 C19,20.6 18.1,21.5 17,21.5 H6.5 C5.4,21.5 4.5,20.6 4.5,19.5 V4.5 C4.5,3.4 5.4,2.5 6.5,2.5 Z M13.5,2.5 V8 H19 Z</Geometry>
    <Geometry x:Key="Glyph.Drive">M3,8 C3,6.9 3.9,6 5,6 H19 C20.1,6 21,6.9 21,8 V16 C21,17.1 20.1,18 19,18 H5 C3.9,18 3,17.1 3,16 Z M15.6,12 A1.3,1.3 0 1 0 18.2,12 A1.3,1.3 0 1 0 15.6,12 Z</Geometry>
    <Geometry x:Key="Glyph.Others">M3,12 A2.6,2.6 0 1 1 8.2,12 A2.6,2.6 0 1 1 3,12 Z M9.4,12 A2.6,2.6 0 1 1 14.6,12 A2.6,2.6 0 1 1 9.4,12 Z M15.8,12 A2.6,2.6 0 1 1 21,12 A2.6,2.6 0 1 1 15.8,12 Z</Geometry>
