<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tema claro: blanco con acentos morados; los bordes fuertes y el texto van en negro.
        Las dos paletas (Palette.xaml y PaletteLight.xaml) tienen exactamente las
        mismas claves: el tema se cambia sustituyendo una por otra.
    -->

    <!-- Superficies -->
    <Color x:Key="C.Void">#FFFFFFFF</Color>
    <Color x:Key="C.Base">#FFFFFFFF</Color>
    <Color x:Key="C.Sidebar">#FFF5F5F7</Color>
    <Color x:Key="C.Surface">#FFFFFFFF</Color>
    <Color x:Key="C.SurfaceRaised">#FFF2F2F5</Color>
    <Color x:Key="C.SurfaceHover">#FFEBEBEF</Color>
    <Color x:Key="C.Well">#FFF7F7F9</Color>

    <!-- Trazos -->
    <Color x:Key="C.Stroke">#FFE3E3E8</Color>
    <Color x:Key="C.StrokeSoft">#FFEDEDF0</Color>
    <Color x:Key="C.StrokeStrong">#FF141416</Color>

    <!-- Texto -->
    <Color x:Key="C.TextPrimary">#FF0A0A0C</Color>
    <Color x:Key="C.TextSecondary">#FF55555E</Color>
    <Color x:Key="C.TextTertiary">#FF8E8E96</Color>
    <Color x:Key="C.TextInverse">#FFFFFFFF</Color>

    <!-- Acento morado -->
    <Color x:Key="C.Accent">#FF7C3AED</Color>
    <Color x:Key="C.AccentBright">#FF6D28D9</Color>
    <Color x:Key="C.AccentDeep">#FF5B21B6</Color>
    <Color x:Key="C.AccentPressed">#FF4C1D95</Color>
    <Color x:Key="C.AccentTint">#FFF4F0FE</Color>
    <Color x:Key="C.AccentTintStrong">#FFECE6FD</Color>

    <!-- Estados -->
    <Color x:Key="C.Ok">#FF7C3AED</Color>
    <Color x:Key="C.Warn">#FFB26B00</Color>
    <Color x:Key="C.Critical">#FFD0243E</Color>
    <Color x:Key="C.Positive">#FF0F8A62</Color>

    <!-- ── Brochas ── -->
    <SolidColorBrush x:Key="Br.Void" Color="{StaticResource C.Void}"/>
    <SolidColorBrush x:Key="Br.Base" Color="{StaticResource C.Base}"/>
    <SolidColorBrush x:Key="Br.Sidebar" Color="{StaticResource C.Sidebar}"/>
    <SolidColorBrush x:Key="Br.Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Br.SurfaceRaised" Color="{StaticResource C.SurfaceRaised}"/>
    <SolidColorBrush x:Key="Br.SurfaceHover" Color="{StaticResource C.SurfaceHover}"/>
    <SolidColorBrush x:Key="Br.Well" Color="{StaticResource C.Well}"/>

    <SolidColorBrush x:Key="Br.Stroke" Color="{StaticResource C.Stroke}"/>
    <SolidColorBrush x:Key="Br.StrokeSoft" Color="{StaticResource C.StrokeSoft}"/>
    <SolidColorBrush x:Key="Br.StrokeStrong" Color="{StaticResource C.StrokeStrong}"/>

    <SolidColorBrush x:Key="Br.TextPrimary" Color="{StaticResource C.TextPrimary}"/>
    <SolidColorBrush x:Key="Br.TextSecondary" Color="{StaticResource C.TextSecondary}"/>
    <SolidColorBrush x:Key="Br.TextTertiary" Color="{StaticResource C.TextTertiary}"/>
    <SolidColorBrush x:Key="Br.TextInverse" Color="{StaticResource C.TextInverse}"/>

    <SolidColorBrush x:Key="Br.Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="Br.AccentBright" Color="{StaticResource C.AccentBright}"/>
    <SolidColorBrush x:Key="Br.AccentDeep" Color="{StaticResource C.AccentDeep}"/>
    <SolidColorBrush x:Key="Br.AccentTint" Color="{StaticResource C.AccentTint}"/>
    <SolidColorBrush x:Key="Br.AccentTintStrong" Color="{StaticResource C.AccentTintStrong}"/>

    <SolidColorBrush x:Key="Br.Ok" Color="{StaticResource C.Ok}"/>
    <SolidColorBrush x:Key="Br.Warn" Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="Br.Critical" Color="{StaticResource C.Critical}"/>
    <SolidColorBrush x:Key="Br.Positive" Color="{StaticResource C.Positive}"/>

    <!-- Piezas de control que dependen del tema -->
    <SolidColorBrush x:Key="Br.Track" Color="#FFE6E6EB"/>
    <SolidColorBrush x:Key="Br.ScrollThumb" Color="#FFCFCFD6"/>
    <SolidColorBrush x:Key="Br.NavHover" Color="#FFEDEDF1"/>
    <SolidColorBrush x:Key="Br.SwitchOff" Color="#FFDCDCE2"/>
    <SolidColorBrush x:Key="Br.SwitchKnobOff" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Br.Option" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Br.Backdrop" Color="#99101014"/>
    <SolidColorBrush x:Key="Br.PositiveTint" Color="#1A0F8A62"/>
    <SolidColorBrush x:Key="Br.WarnTint" Color="#1AB26B00"/>
    <SolidColorBrush x:Key="Br.CriticalTint" Color="#1AD0243E"/>

    <!-- Degradados -->
    <LinearGradientBrush x:Key="Br.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA78BFA" Offset="0"/>
        <GradientStop Color="#FF6D28D9" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Br.HeroGlow" StartPoint="0,0" EndPoint="1,0.7">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFFFFF" Offset="0.6"/>
        <GradientStop Color="#FFFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Br.SidebarFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6F5F9" Offset="0"/>
        <GradientStop Color="#FFF6F5F9" Offset="1"/>
    </LinearGradientBrush>

    <!-- Escenario del mapa de la Lupa: morado en los dos temas para que las burbujas luzcan -->
    <RadialGradientBrush x:Key="Br.LensStage" Center="0.5,0.52" GradientOrigin="0.5,0.52" RadiusX="0.62" RadiusY="0.7">
        <GradientStop Color="#FF8B5CF6" Offset="0"/>
        <GradientStop Color="#FF5B21B6" Offset="0.5"/>
        <GradientStop Color="#FF2E1065" Offset="1"/>
    </RadialGradientBrush>

</ResourceDictionary>
