<Window x:Class="Barep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Barep"
        Icon="/Assets/app.ico"
        Height="770" Width="1180"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Br.Base}"
        Foreground="{StaticResource Br.TextPrimary}"
        FontFamily="{StaticResource Font.Text}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource Br.Base}"
            BorderBrush="{StaticResource Br.Stroke}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════ Identidad (esquina superior izquierda) ══════════ -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Br.Sidebar}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0">
                    <Border Width="26" Height="26" CornerRadius="7" Background="#FFF5F5F7" Margin="0,0,11,0">
                        <Image Source="/Assets/logo.png" Width="21" Height="21"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Barep" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Br.TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══════════ Barra de título con métricas vivas ══════════ -->
            <Grid Grid.Row="0" Grid.Column="1" Background="{StaticResource Br.Base}">
                <!-- Aviso de la red: aparato nuevo o router sospechoso. Clic para verlo. -->
                <Border x:Name="NetToast" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="22,0,0,0" CornerRadius="8" Padding="12,6" Cursor="Hand"
                        Background="{StaticResource Br.WarnTint}" MouseLeftButtonUp="NetToast_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="NetToastDot" Width="7" Height="7" Fill="{StaticResource Br.Warn}"
                                 Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NetToastText" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource Br.TextPrimary}" VerticalAlignment="Center"
                                   MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Ver" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"
                                   Foreground="{StaticResource Br.AccentBright}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="0,0,4,0">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock Text="CPU" Style="{StaticResource T.Caption}"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="CpuPill" Text="—" Style="{StaticResource T.Value}"
                                   FontSize="12" MinWidth="46" VerticalAlignment="Center"/>
                        <Border Width="1" Height="12" Background="{StaticResource Br.Stroke}"
                                Margin="6,0,12,0"/>
                        <TextBlock Text="RAM" Style="{StaticResource T.Caption}"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="RamPill" Text="—" Style="{StaticResource T.Value}"
                                   FontSize="12" MinWidth="46" VerticalAlignment="Center"/>
                        <Border Width="1" Height="12" Background="{StaticResource Br.Stroke}"
                                Margin="6,0,12,0"/>
                        <TextBlock x:Name="ClockText" Text="—" Style="{StaticResource T.Caption}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource BtnCaption}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="Minimizar"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource BtnCaption}"
                            Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar"/>
                    <Button Style="{StaticResource BtnCaptionClose}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Cerrar"/>
                </StackPanel>
            </Grid>

            <!-- ══════════ Barra lateral ══════════ -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Br.Sidebar}"
                    BorderBrush="{StaticResource Br.Stroke}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">

                    <StackPanel DockPanel.Dock="Bottom" Margin="22,0,20,18">
                        <Button x:Name="ThemeButton" Style="{StaticResource BtnLink}" HorizontalAlignment="Left"
                                Margin="-6,0,0,10" Click="Theme_Click" ToolTip="Cambiar entre tema oscuro y claro">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="ThemeIcon" Fill="{StaticResource Br.AccentBright}" Width="13" Height="13"
                                      Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ThemeText" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,14"/>
                        <TextBlock Text="Barep 2.4" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource Br.TextSecondary}"/>
                        <TextBlock x:Name="FooterStatus" Text="Iniciando…"
                                   FontSize="10.5" Foreground="{StaticResource Br.TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Supervisión"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Br.TextTertiary}"
                               Margin="23,18,20,8"/>

                    <!-- Con muchas secciones y la ventana baja, la lista se desplaza en vez de cortarse -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Top">
                        <RadioButton x:Name="NavOverview" Content="Resumen" IsChecked="True"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Overview}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMemory" Content="Memoria"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Memory}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavStorage" Content="Almacenamiento"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Storage}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLens" Content="Lupa"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Lens}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavApps" Content="Aplicaciones"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Apps}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavOptimize" Content="Optimizar"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Optimize}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavProcesses" Content="Procesos"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Processes}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNetwork" Content="Red"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Network}"
                                     Checked="Nav_Checked"/>

                        <TextBlock Text="Equipo" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Br.TextTertiary}"
                                   Margin="23,18,20,8"/>

                        <RadioButton x:Name="NavPc" Content="Mi PC"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Pc}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDisplay" Content="Pantalla"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Display}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavEvidence" Content="Evidencia"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Evidence}"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ══════════ Contenido ══════════ -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1"
                            Background="{StaticResource Br.Base}"/>
        </Grid>
    </Border>
</Window>
