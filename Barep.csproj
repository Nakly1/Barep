<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Barep</RootNamespace>
    <AssemblyName>Barep</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Sin esto, `dotnet restore` no genera destino para net8.0-windows/win-x64
         y publicar despues con ese RID falla con NETSDK1047. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Barep</Product>
    <AssemblyTitle>Barep</AssemblyTitle>
    <Description>Monitor, limpieza y optimización de Windows.</Description>
    <Company>Barep</Company>
    <Version>2.3.0</Version>
    <FileVersion>2.3.0.0</FileVersion>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>es</NeutralLanguage>
  </PropertyGroup>

  <!--
    Publicación en un solo Barep.exe que funciona sin instalar nada (ni .NET):
      dotnet publish -c Release -r win-x64 -o publish
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
