<UserControl x:Class="Barep.Views.EvidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,26,30">

            <TextBlock Text="Evidencia de hardware" Style="{StaticResource T.Title}"/>
            <TextBlock Style="{StaticResource T.Secondary}" Margin="0,4,0,22" MaxWidth="680"
                       HorizontalAlignment="Left"
                       Text="Antes de dejar el equipo en un servicio técnico, genera un acta con el número de serie de cada pieza. Al recogerlo, vuelve a cargar ese archivo y la app te dirá si algo se cambió por otra cosa o directamente falta."/>

            <!-- ─── Generar ─── -->
            <Border Style="{StaticResource CardHero}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Generar acta" Style="{StaticResource T.Headline}"
                                   FontSize="15"/>
                        <TextBlock x:Name="PartCountText" Style="{StaticResource T.Caption}"
                                   HorizontalAlignment="Right" Text=""/>
                    </Grid>
                    <TextBlock Style="{StaticResource T.Secondary}" Margin="0,0,0,18"
                               Text="Se guardan dos archivos: uno .smev.json para verificar después de forma automática, y un .txt imprimible para firmar en la entrega."/>

                    <TextBlock Text="Motivo o destinatario (opcional)" Style="{StaticResource T.Label}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="NoteBox" Style="{StaticResource Field}"
                             Margin="0,0,0,16" MaxLength="160"
                             ToolTip="Por ejemplo: entregado a TecniPC el 9/8 para limpieza y cambio de pasta térmica"/>

                    <WrapPanel>
                        <Button x:Name="GenerateButton" Content="Generar acta"
                                Style="{StaticResource BtnPrimary}"
                                Click="GenerateButton_Click" Margin="0,0,10,10"/>
                        <Button x:Name="PreviewButton" Content="Ver piezas detectadas"
                                Style="{StaticResource Btn}"
                                Click="PreviewButton_Click" Margin="0,0,10,10"/>
                        <Button x:Name="OpenFolderButton" Content="Abrir carpeta de actas"
                                Style="{StaticResource BtnGhost}"
                                Click="OpenFolderButton_Click" Margin="0,0,10,10"/>
                    </WrapPanel>

                    <Border x:Name="FingerprintCard" Style="{StaticResource Well}"
                            Padding="16,14" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Huella SHA-256 del acta" Style="{StaticResource T.Label}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="FingerprintText" Style="{StaticResource T.Mono}"
                                       Foreground="{StaticResource Br.AccentBright}"
                                       TextWrapping="Wrap" LineHeight="19"/>
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Anota esta huella o hazle una foto. Si el archivo del acta se modifica después, la huella deja de coincidir y la verificación te avisará."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ─── Verificar ─── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Verificar el equipo" Style="{StaticResource T.Headline}"
                               FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource T.Secondary}" Margin="0,0,0,18"
                               Text="Carga un acta guardada y se comparará pieza por pieza con el hardware que tiene el equipo en este momento."/>
                    <WrapPanel>
                        <Button x:Name="VerifyButton" Content="Comparar con un acta guardada…"
                                Style="{StaticResource Btn}"
                                Click="VerifyButton_Click" Margin="0,0,10,0"/>
                        <Button x:Name="ExportComparisonButton" Content="Guardar informe de verificación"
                                Style="{StaticResource BtnGhost}"
                                Click="ExportComparisonButton_Click"
                                Visibility="Collapsed"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ─── Veredicto ─── -->
            <Border x:Name="VerdictCard" Style="{StaticResource Card}" Margin="0,0,0,14"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="VerdictTitle" Style="{StaticResource T.Metric}"
                               FontSize="20" Margin="0,0,0,6"/>
                    <TextBlock x:Name="VerdictDetail" Style="{StaticResource T.Secondary}"/>
                    <Border x:Name="IntegrityWarning" Style="{StaticResource Well}"
                            Padding="14,11" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="IntegrityText" Style="{StaticResource T.Secondary}"
                                   Foreground="{StaticResource Br.Warn}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ─── Detalle pieza a pieza ─── -->
            <Border x:Name="ResultsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Detalle pieza a pieza" Style="{StaticResource T.Headline}"
                               Margin="0,0,0,16"/>
                    <StackPanel x:Name="ResultsPanel"/>
                </StackPanel>
            </Border>

            <!-- ─── Vista previa del inventario ─── -->
            <Border x:Name="PreviewCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Piezas que se registrarán" Style="{StaticResource T.Headline}"
                               Margin="0,0,0,16"/>
                    <StackPanel x:Name="PreviewPanel"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource T.Caption}"
                       Margin="2,14,0,0" TextWrapping="Wrap" Text=" "/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
