<UserControl x:Class="Barep.Views.EvidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Fila de la lista de actas guardadas -->
        <DataTemplate x:Key="ActaRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Br.AccentTint}"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Path Data="{StaticResource Glyph.File}" Fill="{StaticResource Br.AccentBright}"
                          Width="13" Height="13" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Value}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Caption}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,24,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Evidencia" Style="{StaticResource T.Title}"/>
            <TextBlock Style="{StaticResource T.Secondary}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       Text="Antes de dejar el equipo en un servicio técnico, crea un acta: guarda el número de serie de cada pieza. Al recogerlo, ábrela y pulsa «Comprobar»: Barep te dice si cambiaron o falta alguna."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════ Pasos ══════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Br.AccentGradient}"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="1" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Antes de dejarlo" Style="{StaticResource T.Headline}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Guarda el número de serie del procesador, la RAM, los discos, la placa y la tarjeta de red."/>
                            <TextBlock Text="¿A QUIÉN SE LO DEJAS? (OPCIONAL)" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <TextBox x:Name="NoteBox" Style="{StaticResource Field}" Height="34" Padding="11,0"
                                         MaxLength="160" TextChanged="NoteBox_TextChanged"/>
                                <TextBlock x:Name="NoteHint" Text="Ej.: TecniPC, cambio de pantalla" Style="{StaticResource T.Caption}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <Button x:Name="CreateButton" Content="Crear acta" Style="{StaticResource BtnPrimary}"
                                    Padding="16,9" HorizontalAlignment="Stretch" Click="Create_Click"/>
                            <TextBlock x:Name="PartCountText" Style="{StaticResource T.Caption}" Margin="0,10,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="0">
                        <StackPanel>
                            <StackPanel Margin="20,18,20,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Br.AccentGradient}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="2" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Al recogerlo" Style="{StaticResource T.Headline}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Elige el acta y pulsa «Comprobar» a la derecha."/>
                            </StackPanel>
                            <ListBox x:Name="ActaList" Style="{StaticResource SelectList}" MaxHeight="300"
                                     ItemTemplate="{StaticResource ActaRowTemplate}" Margin="10,0,10,0"
                                     SelectionChanged="ActaList_SelectionChanged"/>
                            <TextBlock x:Name="NoActasText" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                       Margin="20,0,20,6" Visibility="Collapsed"
                                       Text="Todavía no hay actas. Crea una antes de llevar el equipo al técnico."/>
                            <Button Content="Abrir un acta de otra carpeta…" Style="{StaticResource BtnLink}"
                                    HorizontalAlignment="Left" Margin="16,6,0,14" Click="OpenOther_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ficha completa del equipo" Style="{StaticResource T.Value}"/>
                            <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                                       Text="Todo el hardware del equipo en un archivo de texto, para guardarlo o enviarlo a quien te lo vaya a arreglar."/>
                            <Button x:Name="SheetButton" Content="Guardar ficha (.txt)" Style="{StaticResource BtnGhost}"
                                    Padding="14,7" HorizontalAlignment="Left" Click="Sheet_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════ El acta ══════════ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <StackPanel x:Name="ActaEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                        <Image Source="/Assets/logo.png" Width="84" Height="84" Opacity="0.9"
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,16"/>
                        <TextBlock Text="Aquí verás el acta" Style="{StaticResource T.Headline}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource T.Secondary}" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="360" Margin="0,6,0,0"
                                   Text="Crea una o elige una de la lista. Al comprobarla, cada pieza se marca como igual, cambiada o desaparecida."/>
                    </StackPanel>

                    <ScrollViewer x:Name="ActaView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="28,24,24,24">
                            <!-- Cabecera del documento -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="13" Background="#FFF5F5F7" Margin="0,0,14,0">
                                    <Image Source="/Assets/logo.png" Width="40" Height="40"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ACTA DE HARDWARE" Style="{StaticResource T.Label}"/>
                                    <TextBlock x:Name="ActaDate" Style="{StaticResource T.Metric}" FontSize="20" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" x:Name="IntegrityChip" Style="{StaticResource Chip}" VerticalAlignment="Top">
                                    <TextBlock x:Name="IntegrityText" Style="{StaticResource ChipText}"/>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="ActaSpecs" Margin="0,0,0,8"/>

                            <WrapPanel Margin="0,6,0,16">
                                <Button x:Name="CompareButton" Content="Comprobar ahora" Style="{StaticResource BtnPrimary}"
                                        Padding="18,8" Margin="0,0,8,8" Click="Compare_Click"/>
                                <Button x:Name="PrintButton" Content="Guardar para imprimir" Style="{StaticResource BtnGhost}"
                                        Padding="14,8" Margin="0,0,8,8" Click="Print_Click"/>
                                <Button x:Name="RevealButton" Content="Mostrar en carpeta" Style="{StaticResource BtnGhost}"
                                        Padding="14,8" Margin="0,0,8,8" Click="Reveal_Click"/>
                                <Button x:Name="DeleteButton" Content="Borrar acta" Style="{StaticResource BtnLink}"
                                        Margin="4,0,0,8" VerticalAlignment="Center" Click="Delete_Click"/>
                            </WrapPanel>

                            <!-- Resultado de la comprobación -->
                            <Border x:Name="VerdictBanner" CornerRadius="12" Padding="18,14" Margin="0,0,0,18"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="VerdictIcon" Width="20" Height="20" Stretch="Uniform" Margin="0,2,14,0"
                                          VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="VerdictTitle" Style="{StaticResource T.Headline}"/>
                                        <TextBlock x:Name="VerdictDetail" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="PartsPanel"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource T.Caption}" Margin="2,12,0,0"
                   TextWrapping="Wrap" Text=" "/>
    </Grid>
</UserControl>
