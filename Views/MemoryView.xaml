<UserControl x:Class="Barep.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Barep.Controls"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,26,30">

            <TextBlock Text="Memoria" Style="{StaticResource T.Title}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource T.Secondary}"
                       Text="Leyendo los módulos instalados…" Margin="0,4,0,22"/>

            <!-- ─── Uso en vivo ─── -->
            <Border Style="{StaticResource CardHero}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="En uso ahora" Style="{StaticResource T.Headline}"
                                   Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PercentText" Text="—" Style="{StaticResource T.Hero}"/>
                            <TextBlock Text="%" Style="{StaticResource T.Metric}"
                                       Foreground="{StaticResource Br.TextTertiary}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,7"/>
                        </StackPanel>
                        <TextBlock x:Name="AmountText" Text="—" Style="{StaticResource T.Secondary}"
                                   Margin="0,2,0,14"/>
                        <ProgressBar x:Name="UsageBar" Style="{StaticResource MeterLarge}"
                                     Maximum="100" Value="0" Margin="0,0,0,16"/>
                        <StackPanel x:Name="UsageSpecs"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource Well}" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Historial · últimos 2 minutos"
                                           Style="{StaticResource T.Caption}"/>
                                <TextBlock x:Name="UpdatedText" Style="{StaticResource T.Caption}"
                                           HorizontalAlignment="Right" Text="—"/>
                            </Grid>
                            <c:Sparkline x:Name="Spark" Grid.Row="1" Capacity="60" MinHeight="150"
                                         GridBrush="{StaticResource Br.StrokeSoft}"
                                         LineBrush="{StaticResource Br.Accent}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ─── Resumen físico ─── -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,22">
                <Grid x:Name="SummaryStrip">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="20,17">
                        <TextBlock Text="Total instalada" Style="{StaticResource T.Label}"/>
                        <TextBlock x:Name="TotalText" Text="—" Style="{StaticResource T.Metric}"
                                   FontSize="21" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource Br.StrokeSoft}" Margin="0,14"/>

                    <StackPanel Grid.Column="2" Margin="20,17">
                        <TextBlock Text="Tecnología" Style="{StaticResource T.Label}"/>
                        <TextBlock x:Name="TypeText" Text="—" Style="{StaticResource T.Metric}"
                                   FontSize="21" Foreground="{StaticResource Br.AccentBright}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="{StaticResource Br.StrokeSoft}" Margin="0,14"/>

                    <StackPanel Grid.Column="4" Margin="20,17">
                        <TextBlock Text="Velocidad" Style="{StaticResource T.Label}"/>
                        <TextBlock x:Name="SpeedText" Text="—" Style="{StaticResource T.Metric}"
                                   FontSize="21" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="5" Background="{StaticResource Br.StrokeSoft}" Margin="0,14"/>

                    <StackPanel Grid.Column="6" Margin="20,17">
                        <TextBlock Text="Ranuras" Style="{StaticResource T.Label}"/>
                        <TextBlock x:Name="SlotsText" Text="—" Style="{StaticResource T.Metric}"
                                   FontSize="21" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── Módulos ─── -->
            <Grid Margin="0,0,0,14">
                <TextBlock Text="Módulos instalados" Style="{StaticResource T.Headline}"
                           FontSize="15" VerticalAlignment="Center"/>
                <TextBlock x:Name="ModulesHintText" Style="{StaticResource T.Caption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Text=""/>
            </Grid>

            <ItemsControl x:Name="ModulesPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
