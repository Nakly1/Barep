<UserControl x:Class="Barep.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24,26,90">

                <TextBlock Text="Optimizar" Style="{StaticResource T.Title}"/>
                <TextBlock Style="{StaticResource T.Secondary}" Margin="0,4,0,20" MaxWidth="760" HorizontalAlignment="Left"
                           Text="Ajustes de Windows para que el equipo vaya más ligero, sea más privado y tenga menos anuncios. Cada interruptor muestra si la función está encendida; todo se puede deshacer con el mismo interruptor."/>

                <!-- Resumen -->
                <Border Style="{StaticResource CardHero}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SummaryCount" Style="{StaticResource T.Metric}" Text="—"/>
                                <TextBlock x:Name="SummaryTotal" Style="{StaticResource T.Secondary}" FontSize="15"
                                           VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="ajustes recomendados ya aplicados" Style="{StaticResource T.Caption}" Margin="0,2,0,12"/>
                            <ProgressBar x:Name="SummaryMeter" Style="{StaticResource MeterLarge}" Maximum="1"/>
                            <TextBlock x:Name="AdminNote" Style="{StaticResource T.Caption}" Foreground="{StaticResource Br.Warn}"
                                       Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="ApplyAllButton" Style="{StaticResource BtnPrimary}" Padding="20,10"
                                    Click="ApplyAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Optimize}" Fill="White" Width="12" Height="12"
                                          Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Aplicar lo recomendado"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AdminButton" Content="Abrir como administrador" Style="{StaticResource BtnGhost}"
                                    Margin="0,8,0,0" Click="Admin_Click" Visibility="Collapsed"
                                    ToolTip="Algunos ajustes sólo se pueden cambiar con permisos de administrador"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <Border Style="{StaticResource Segmented}">
                        <StackPanel x:Name="FilterPanel" Orientation="Horizontal"/>
                    </Border>
                </ScrollViewer>
                <StackPanel x:Name="TweaksPanel"/>

                <TextBlock Style="{StaticResource T.Caption}" Margin="2,10,0,0" TextWrapping="Wrap" MaxWidth="760"
                           HorizontalAlignment="Left"
                           Text="Lo que no está aquí es a propósito: desactivar Windows Defender, Windows Update o servicios del sistema «para ganar rendimiento» suele romper cosas y dejar el equipo desprotegido."/>
            </StackPanel>
        </ScrollViewer>

        <!-- Aviso de reinicio -->
        <Border x:Name="RestartBanner" Style="{StaticResource CardHero}" Padding="18,12" Margin="30,0,40,18"
                VerticalAlignment="Bottom" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="6" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RestartText" Style="{StaticResource T.Value}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="RestartExplorerButton" Grid.Column="1" Content="Reiniciar Explorador"
                        Style="{StaticResource BtnPrimary}" Click="RestartExplorer_Click"/>
            </Grid>
        </Border>

        <!-- Confirmación de «Aplicar lo recomendado» -->
        <Grid x:Name="Overlay" Visibility="Collapsed" Background="{StaticResource Br.Backdrop}">
            <Border Style="{StaticResource CardHero}" Width="600" MaxHeight="620" Margin="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="50" ShadowDepth="10" Opacity="0.6"/>
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="DialogTitle" Style="{StaticResource T.Headline}" FontSize="16"/>
                        <TextBlock x:Name="DialogMessage" Style="{StaticResource T.Secondary}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="DialogProgressPanel" DockPanel.Dock="Bottom" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="DialogProgressText" Style="{StaticResource T.Value}" Margin="0,0,0,8"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="DialogProgressBar" Style="{StaticResource MeterLarge}" Maximum="1"/>
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <TextBlock x:Name="DialogTotal" Style="{StaticResource T.Value}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DialogCancel" Content="Cancelar" Style="{StaticResource BtnGhost}" Margin="0,0,10,0"
                                    Click="DialogCancel_Click"/>
                            <Button x:Name="DialogConfirm" Style="{StaticResource BtnPrimary}" Padding="18,9"
                                    Click="DialogConfirm_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="DialogListHost" Style="{StaticResource Well}" Margin="0,16,0,0" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                            <StackPanel x:Name="DialogList"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
