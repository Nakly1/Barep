<UserControl x:Class="Barep.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Fila de la lista de aparatos -->
        <DataTemplate x:Key="DeviceRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="9" HorizontalAlignment="Left"
                        Background="{Binding TileBrush}">
                    <Path Data="{Binding Glyph}" Fill="{Binding GlyphBrush}" Width="17" Height="17" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Value}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1"
                                Background="{Binding BadgeBrush}" Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" Style="{StaticResource ChipText}" FontSize="10"
                                       Foreground="{Binding BadgeForeground}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SubText}" Style="{StaticResource T.Caption}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding IpText}" Style="{StaticResource T.Mono}" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                        <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource T.Caption}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,24,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ Cabecera ══════════ -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Red" Style="{StaticResource T.Title}"/>
                <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource T.Secondary}" Margin="0,4,0,0"
                           Text="Quién está conectado a tu red, qué tan rápida va y qué tan protegida está."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel x:Name="ScanProgressBox" VerticalAlignment="Center" Margin="0,0,14,0" Width="220"
                            Visibility="Collapsed">
                    <TextBlock x:Name="ScanProgressText" Style="{StaticResource T.Caption}"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="ScanProgressBar" Style="{StaticResource Meter}" Maximum="100"
                                 Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock x:Name="LastScanText" Style="{StaticResource T.Caption}" VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <Button x:Name="ScanButton" Content="Analizar la red" Style="{StaticResource BtnPrimary}"
                        Padding="16,8" Click="Scan_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════ Pestañas ══════════ -->
        <Border Grid.Row="1" Style="{StaticResource Segmented}" Margin="0,20,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabSummary" Content="Resumen" GroupName="NetTab" IsChecked="True"
                             Style="{StaticResource FilterChip}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabDevices" Content="Aparatos" GroupName="NetTab"
                             Style="{StaticResource FilterChip}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabActivity" Content="Actividad" GroupName="NetTab"
                             Style="{StaticResource FilterChip}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSpeed" Content="Velocidad" GroupName="NetTab"
                             Style="{StaticResource FilterChip}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabWifi" Content="Wi-Fi" GroupName="NetTab"
                             Style="{StaticResource FilterChip}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSecurity" Content="Seguridad" GroupName="NetTab"
                             Style="{StaticResource FilterChip}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabConnections" Content="Conexiones" GroupName="NetTab"
                             Style="{StaticResource FilterChip}" Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">

            <!-- ══════════ Resumen ══════════ -->
            <ScrollViewer x:Name="PanelSummary" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <Border x:Name="AlertBanner" CornerRadius="12" Padding="18,14" Margin="0,0,0,12"
                            Background="{StaticResource Br.CriticalTint}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource Glyph.Info}" Fill="{StaticResource Br.Critical}" Width="18"
                                  Height="18" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="AlertTitle" Style="{StaticResource T.Value}"/>
                                <TextBlock x:Name="AlertText" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                           Margin="0,3,12,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Ver actividad" Style="{StaticResource BtnGhost}"
                                    Padding="12,6" VerticalAlignment="Center" Click="GoActivity_Click"/>
                        </Grid>
                    </Border>

                    <Border x:Name="NewBanner" CornerRadius="12" Padding="18,14" Margin="0,0,0,12"
                            Background="{StaticResource Br.WarnTint}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="{StaticResource Br.Warn}" Margin="2,5,14,0"
                                     VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="NewTitle" Style="{StaticResource T.Value}"/>
                                <TextBlock x:Name="NewText" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                           Margin="0,3,12,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Ver aparatos" Style="{StaticResource BtnGhost}" Padding="12,6"
                                        Margin="0,0,8,0" Click="GoDevices_Click"/>
                                <Button Content="Todo es mío" Style="{StaticResource BtnPrimary}" Padding="12,6"
                                        Click="TrustAll_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="4" Margin="-6,0,-6,12">
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="RED" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="SumNet" Text="—" Style="{StaticResource T.Metric}" FontSize="20"
                                           Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SumNetCaption" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="SumNetSignal" Style="{StaticResource Meter}" Maximum="100"
                                             Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="APARATOS" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="SumDevices" Text="—" Style="{StaticResource T.Metric}" FontSize="20"
                                           Margin="0,8,0,0"/>
                                <TextBlock x:Name="SumDevicesCaption" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="VELOCIDAD" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="SumSpeed" Text="—" Style="{StaticResource T.Metric}" FontSize="20"
                                           Margin="0,8,0,0"/>
                                <TextBlock x:Name="SumSpeedCaption" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="SEGURIDAD" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="SumSecurity" Text="—" Style="{StaticResource T.Metric}" FontSize="20"
                                           Margin="0,8,0,0"/>
                                <TextBlock x:Name="SumSecurityCaption" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tu conexión" Style="{StaticResource T.Headline}" Margin="0,0,0,14"/>
                                <StackPanel x:Name="SumSpecs"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="Últimos movimientos" Style="{StaticResource T.Headline}"/>
                                    <Button Content="Ver todo" Style="{StaticResource BtnLink}" HorizontalAlignment="Right"
                                            Click="GoActivity_Click"/>
                                </Grid>
                                <StackPanel x:Name="SumEvents"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════ Aparatos ══════════ -->
            <Grid x:Name="PanelDevices" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,14,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="DeviceSearch" Style="{StaticResource Field}" Height="34" Padding="11,0"
                                         TextChanged="DeviceSearch_Changed"/>
                                <TextBlock x:Name="DeviceSearchHint" Text="Buscar por nombre, marca, IP o MAC…"
                                           Style="{StaticResource T.Caption}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <Border Grid.Column="1" Style="{StaticResource Segmented}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DevFilterAll" Content="Todos" GroupName="NetDevFilter"
                                                 IsChecked="True" Style="{StaticResource FilterChip}"
                                                 Checked="DeviceFilter_Checked"/>
                                    <RadioButton x:Name="DevFilterOnline" Content="Conectados" GroupName="NetDevFilter"
                                                 Style="{StaticResource FilterChip}" Checked="DeviceFilter_Checked"/>
                                    <RadioButton x:Name="DevFilterNew" Content="Nuevos" GroupName="NetDevFilter"
                                                 Style="{StaticResource FilterChip}" Checked="DeviceFilter_Checked"/>
                                    <RadioButton x:Name="DevFilterStrangers" Content="Sin reconocer"
                                                 GroupName="NetDevFilter" Style="{StaticResource FilterChip}"
                                                 Checked="DeviceFilter_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Divider}" Margin="14,0,14,2"/>
                        <Grid>
                            <ListBox x:Name="DeviceList" Style="{StaticResource SelectList}"
                                     ItemTemplate="{StaticResource DeviceRowTemplate}" Margin="8,2,6,8"
                                     SelectionChanged="DeviceList_SelectionChanged"/>
                            <TextBlock x:Name="DeviceEmpty" Style="{StaticResource T.Secondary}"
                                       Foreground="{StaticResource Br.TextTertiary}" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="30" Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <TextBlock x:Name="DeviceHint" Style="{StaticResource T.Secondary}"
                                   Foreground="{StaticResource Br.TextTertiary}" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="28" Text="Elige un aparato para ver qué es, desde cuándo está y qué tiene abierto."/>

                        <ScrollViewer x:Name="DeviceDetail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                                      Padding="20,18,16,18">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="DetailTile" Width="64" Height="64" CornerRadius="16"
                                            Margin="0,0,14,0" Background="{StaticResource Br.AccentTint}">
                                        <Path x:Name="DetailGlyph" Fill="{StaticResource Br.AccentBright}" Width="32"
                                              Height="32" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailName" Style="{StaticResource T.Headline}" FontSize="16"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="DetailSub" Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel x:Name="DetailChips" Margin="0,0,0,14"/>

                                <TextBlock Text="NOMBRE PARA RECONOCERLO" Style="{StaticResource T.Label}"
                                           Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="AliasBox" Style="{StaticResource Field}" Height="34" Padding="11,0"
                                                 TextChanged="AliasBox_TextChanged" KeyDown="AliasBox_KeyDown"/>
                                        <TextBlock x:Name="AliasHint" Text="Ej.: Móvil de mamá" Style="{StaticResource T.Caption}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Button Grid.Column="1" x:Name="AliasSave" Content="Guardar" Style="{StaticResource BtnGhost}"
                                            Padding="12,6" Margin="8,0,0,0" Click="AliasSave_Click"/>
                                </Grid>

                                <StackPanel x:Name="DetailSpecs"/>

                                <TextBlock Text="CONECTADO HOY" Style="{StaticResource T.Label}" Margin="0,10,0,6"/>
                                <Grid x:Name="DetailTimeline" Height="14"/>
                                <Grid Margin="0,4,0,14">
                                    <TextBlock Text="0 h" Style="{StaticResource T.Caption}" FontSize="10"/>
                                    <TextBlock Text="12 h" Style="{StaticResource T.Caption}" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="24 h" Style="{StaticResource T.Caption}" FontSize="10"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="TrustButton" Style="{StaticResource BtnPrimary}" Padding="12,7"
                                            Margin="0,0,8,8" Click="Trust_Click"/>
                                    <Button x:Name="PortsButton" Content="Ver puertos abiertos" Style="{StaticResource BtnGhost}"
                                            Padding="12,7" Margin="0,0,8,8" Click="Ports_Click"/>
                                    <Button x:Name="PhotosButton" Content="Ver fotos del modelo" Style="{StaticResource BtnGhost}"
                                            Padding="12,7" Margin="0,0,8,8" Click="Photos_Click"/>
                                    <Button x:Name="RouterButton" Content="Abrir panel del router"
                                            Style="{StaticResource BtnGhost}" Padding="12,7" Margin="0,0,8,8"
                                            Click="Router_Click"/>
                                    <Button x:Name="CopyButton" Content="Copiar IP" Style="{StaticResource BtnGhost}"
                                            Padding="12,7" Margin="0,0,8,8" Click="Copy_Click"/>
                                    <Button x:Name="ForgetButton" Content="Olvidar" Style="{StaticResource BtnLink}"
                                            Margin="0,0,8,8" VerticalAlignment="Center" Click="Forget_Click"/>
                                </WrapPanel>

                                <StackPanel x:Name="DetailPorts"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════ Actividad ══════════ -->
            <ScrollViewer x:Name="PanelActivity" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Vigilar mi red mientras Barep está abierto" Style="{StaticResource T.Value}"/>
                                <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,4,20,0"
                                           Text="Cada 3 minutos mira quién está conectado, apunta quién entra y quién sale y te avisa en la barra de arriba si aparece un aparato que nunca se había visto."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WatchSwitch" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" Click="WatchSwitch_Click"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Ahora mismo" Style="{StaticResource T.Headline}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="NowCaption" Style="{StaticResource T.Caption}" Margin="0,0,0,14"/>
                                <StackPanel x:Name="NowList"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Historial" Style="{StaticResource T.Headline}" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,0,0,14" TextWrapping="Wrap"
                                           Text="Entradas y salidas de los aparatos de esta red. Sólo se registra mientras Barep está abierto."/>
                                <StackPanel x:Name="EventList"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════ Velocidad ══════════ -->
            <ScrollViewer x:Name="PanelSpeed" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource CardHero}" Margin="0,0,0,12" Padding="26,22">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Test de velocidad" Style="{StaticResource T.Headline}"/>
                                    <TextBlock x:Name="SpeedPhaseText" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                               Text="Mide la bajada, la subida y el ping de tu internet. Tarda unos 25 segundos y gasta unos cientos de MB."/>
                                </StackPanel>
                                <Button x:Name="SpeedButton" Content="Empezar" Style="{StaticResource BtnPrimary}"
                                        Padding="22,9" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="Speed_Click"/>
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="BAJADA" Style="{StaticResource T.Label}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="SpeedDown" Text="—" Style="{StaticResource T.Metric}" FontSize="34"/>
                                        <TextBlock Text="Mbps" Style="{StaticResource T.Caption}" Margin="6,0,0,6"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="SUBIDA" Style="{StaticResource T.Label}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="SpeedUp" Text="—" Style="{StaticResource T.Metric}" FontSize="34"/>
                                        <TextBlock Text="Mbps" Style="{StaticResource T.Caption}" Margin="6,0,0,6"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="PING" Style="{StaticResource T.Label}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="SpeedPing" Text="—" Style="{StaticResource T.Metric}" FontSize="34"/>
                                        <TextBlock Text="ms" Style="{StaticResource T.Caption}" Margin="6,0,0,6"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="VARIACIÓN" Style="{StaticResource T.Label}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="SpeedJitter" Text="—" Style="{StaticResource T.Metric}" FontSize="34"/>
                                        <TextBlock Text="ms" Style="{StaticResource T.Caption}" Margin="6,0,0,6"
                                                   VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>

                            <ProgressBar x:Name="SpeedMeter" Style="{StaticResource MeterLarge}" Maximum="100"
                                         Margin="0,20,0,0"/>
                            <TextBlock x:Name="SpeedVerdict" Style="{StaticResource T.Body}" TextWrapping="Wrap"
                                       Margin="0,16,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="SpeedServer" Style="{StaticResource T.Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tests anteriores" Style="{StaticResource T.Headline}" Margin="0,0,0,14"/>
                            <StackPanel x:Name="SpeedHistory"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════ Wi-Fi ══════════ -->
            <ScrollViewer x:Name="PanelWifi" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">
                    <Border x:Name="LocationBanner" CornerRadius="12" Padding="18,14" Margin="0,0,0,12"
                            Background="{StaticResource Br.WarnTint}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Windows pide permiso de ubicación para ver el Wi-Fi" Style="{StaticResource T.Value}"/>
                                <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,3,12,0"
                                           Text="Desde Windows 11 24H2, para leer el nombre de las redes hay que activar «Permitir que las aplicaciones de escritorio accedan a tu ubicación». Barep no usa tu ubicación."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Abrir permisos" Style="{StaticResource BtnGhost}"
                                    Padding="12,6" VerticalAlignment="Center" Click="LocationSettings_Click"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Tu Wi-Fi" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="WifiName" Text="—" Style="{StaticResource T.Metric}" FontSize="22"
                                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                <Grid Margin="0,12,0,4">
                                    <TextBlock Text="Señal" Style="{StaticResource T.Caption}"/>
                                    <TextBlock x:Name="WifiSignalText" Style="{StaticResource T.Caption}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="WifiSignal" Style="{StaticResource MeterLarge}" Maximum="100"
                                             Margin="0,0,0,16"/>
                                <StackPanel x:Name="WifiSpecs"/>
                                <TextBlock x:Name="WifiAdvice" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Redes alrededor" Style="{StaticResource T.Headline}"/>
                                    <Button Content="Volver a buscar" Style="{StaticResource BtnLink}"
                                            HorizontalAlignment="Right" Click="WifiRefresh_Click"/>
                                </Grid>
                                <TextBlock x:Name="ChannelAdvice" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>
                                <StackPanel x:Name="NearbyList"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Hacer que vaya más rápido" Style="{StaticResource T.Headline}"/>
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,18" TextWrapping="Wrap"
                                       Text="Lo que se puede cambiar desde este PC. La velocidad que te da tu operador no se sube desde aquí, pero sí que llegue entera y con menos retraso."/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Quitar el ahorro de energía del Wi-Fi" Style="{StaticResource T.Value}"/>
                                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Con batería, Windows duerme el Wi-Fi entre envío y envío para ahorrar: sube el ping y los juegos y las videollamadas van a tirones. Activado, el Wi-Fi va siempre a tope; en un portátil gasta algo más de batería."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="110">
                                    <ToggleButton x:Name="WifiPowerSwitch" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Center" Click="WifiPower_Click"/>
                                    <TextBlock x:Name="WifiPowerState" Style="{StaticResource T.Caption}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Usar el DNS más rápido" Style="{StaticResource T.Value}"/>
                                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="El DNS traduce el nombre de cada página a su dirección. Si responde rápido, las páginas empiezan a cargar antes. Barep mide el que usas frente a Cloudflare, Google y Quad9 y puedes cambiar con un clic (Windows pedirá permiso)."/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="DnsTestButton" Content="Medir" Style="{StaticResource BtnGhost}"
                                        Padding="18,7" VerticalAlignment="Center" Click="DnsTest_Click"/>
                            </Grid>
                            <StackPanel x:Name="DnsResults"/>
                            <Border Style="{StaticResource Divider}" Margin="0,6,0,16"/>

                            <TextBlock Text="En el router" Style="{StaticResource T.Value}"/>
                            <TextBlock x:Name="RouterTips" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════ Seguridad ══════════ -->
            <ScrollViewer x:Name="PanelSecurity" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource CardHero}" Margin="0,0,0,12" Padding="26,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,26,0">
                                <TextBlock x:Name="ScoreText" Text="—" Style="{StaticResource T.Metric}" FontSize="44"/>
                                <TextBlock Text="de 100" Style="{StaticResource T.Caption}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ScoreTitle" Style="{StaticResource T.Headline}"/>
                                <TextBlock x:Name="ScoreCaption" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                           Margin="0,4,20,0"/>
                                <ProgressBar x:Name="ScoreMeter" Style="{StaticResource MeterLarge}" Maximum="100"
                                             Margin="0,12,20,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Revisar de nuevo" Style="{StaticResource BtnGhost}"
                                    Padding="14,8" VerticalAlignment="Center" Click="SecurityRefresh_Click"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="SecurityList"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════ Conexiones ══════════ -->
            <ScrollViewer x:Name="PanelConnections" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,0,180,0"
                                   VerticalAlignment="Center"
                                   Text="Con quién habla cada programa de este PC ahora mismo y qué puertos tiene abiertos para que otros se conecten a él."/>
                        <Button Content="Actualizar" Style="{StaticResource BtnGhost}" Padding="14,7"
                                HorizontalAlignment="Right" Click="ConnectionsRefresh_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Programas conectados a internet" Style="{StaticResource T.Headline}"/>
                                <TextBlock x:Name="ConnCaption" Style="{StaticResource T.Caption}" Margin="0,4,0,14"/>
                                <StackPanel x:Name="ConnList"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Puertos abiertos en este PC" Style="{StaticResource T.Headline}"/>
                                <TextBlock x:Name="ListenCaption" Style="{StaticResource T.Caption}" Margin="0,4,0,14"
                                           TextWrapping="Wrap"/>
                                <StackPanel x:Name="ListenList"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource T.Caption}" Margin="2,12,0,0"
                   TextWrapping="Wrap" Text=" "/>
    </Grid>
</UserControl>
