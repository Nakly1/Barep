<UserControl x:Class="Barep.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Barep.Controls"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,26,30">

            <TextBlock Text="Resumen" Style="{StaticResource T.Title}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource T.Secondary}"
                       Text="Leyendo el equipo…" Margin="0,4,0,22"/>

            <!-- ─── Memoria y procesador ─── -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardHero}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Memoria" Style="{StaticResource T.Headline}"/>
                            <TextBlock x:Name="RamStateText" Style="{StaticResource T.Caption}"
                                       HorizontalAlignment="Right" Text="—"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock x:Name="RamPercentText" Text="—" Style="{StaticResource T.Hero}"/>
                            <TextBlock Text="%" Style="{StaticResource T.Metric}"
                                       Foreground="{StaticResource Br.TextTertiary}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,7"/>
                        </StackPanel>

                        <TextBlock x:Name="RamAmountText" Style="{StaticResource T.Secondary}"
                                   Text="—" Margin="0,0,0,14"/>

                        <ProgressBar x:Name="RamBar" Style="{StaticResource MeterLarge}"
                                     Maximum="100" Value="0" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource Well}" Height="72" Padding="10,8">
                            <Grid>
                                <TextBlock Text="Últimos 2 minutos" Style="{StaticResource T.Caption}"
                                           VerticalAlignment="Top"/>
                                <c:Sparkline x:Name="RamSpark" Capacity="60" Margin="0,14,0,0"
                                             GridBrush="{StaticResource Br.StrokeSoft}"
                                             LineBrush="{StaticResource Br.Accent}"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Disponible" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="RamFreeText" Text="—" Style="{StaticResource T.Value}"
                                           FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="En uso" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="RamUsedText" Text="—" Style="{StaticResource T.Value}"
                                           FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardHero}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Procesador" Style="{StaticResource T.Headline}"/>
                            <TextBlock x:Name="CpuStateText" Style="{StaticResource T.Caption}"
                                       HorizontalAlignment="Right" Text="—"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock x:Name="CpuPercentText" Text="—" Style="{StaticResource T.Hero}"/>
                            <TextBlock Text="%" Style="{StaticResource T.Metric}"
                                       Foreground="{StaticResource Br.TextTertiary}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,7"/>
                        </StackPanel>

                        <TextBlock x:Name="CpuNameText" Style="{StaticResource T.Secondary}"
                                   Text="—" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Margin="0,0,0,14"/>

                        <ProgressBar x:Name="CpuBar" Style="{StaticResource MeterLarge}"
                                     Maximum="100" Value="0" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource Well}" Height="72" Padding="10,8">
                            <Grid>
                                <TextBlock Text="Últimos 2 minutos" Style="{StaticResource T.Caption}"
                                           VerticalAlignment="Top"/>
                                <c:Sparkline x:Name="CpuSpark" Capacity="60" Margin="0,14,0,0"
                                             GridBrush="{StaticResource Br.StrokeSoft}"
                                             LineBrush="{StaticResource Br.AccentBright}"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Núcleos e hilos" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="CpuCoresText" Text="—" Style="{StaticResource T.Value}"
                                           FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Frecuencia máxima" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="CpuSpeedText" Text="—" Style="{StaticResource T.Value}"
                                           FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ─── Gráficos · Red · Energía ─── -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gráficos" Style="{StaticResource T.Headline}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="GpuNameText" Text="—" Style="{StaticResource T.Body}"
                                   FontWeight="Medium" Margin="0,0,0,10"/>
                        <StackPanel x:Name="GpuSpecs"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Red" Style="{StaticResource T.Headline}" Margin="0,0,0,12"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Descarga" Style="{StaticResource T.Label}"/>
                            <TextBlock x:Name="NetDownText" Text="—" Style="{StaticResource T.Metric}"
                                       FontSize="22" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Subida" Style="{StaticResource T.Label}"/>
                            <TextBlock x:Name="NetUpText" Text="—" Style="{StaticResource T.Metric}"
                                       FontSize="22" Foreground="{StaticResource Br.AccentBright}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Energía" Style="{StaticResource T.Headline}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="BatteryPercentText" Text="—" Style="{StaticResource T.Metric}"
                                   Margin="0,0,0,8"/>
                        <ProgressBar x:Name="BatteryBar" Style="{StaticResource Meter}"
                                     Maximum="100" Value="0" Margin="0,0,0,10"/>
                        <TextBlock x:Name="BatteryStatusText" Text="—" Style="{StaticResource T.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ─── Identidad del equipo ─── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Este equipo" Style="{StaticResource T.Headline}"/>
                        <TextBlock x:Name="UptimeText" Style="{StaticResource T.Caption}"
                                   HorizontalAlignment="Right" Text="—"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="SystemSpecsLeft" Grid.Column="0"/>
                        <StackPanel x:Name="SystemSpecsRight" Grid.Column="2"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
