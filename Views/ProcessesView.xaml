<UserControl x:Class="Barep.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Fila de un programa: todos sus procesos sumados -->
        <DataTemplate x:Key="ProcessRowTemplate">
            <Border x:Name="RowBd" Background="Transparent" CornerRadius="8" Padding="4,2"
                    Cursor="Hand" ToolTip="{Binding Tip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="116"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Visibility="{Binding ImageVisibility}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Path Data="{StaticResource Glyph.Stack}" Fill="{StaticResource Br.TextTertiary}"
                              Stretch="Uniform" Margin="3" Visibility="{Binding GlyphVisibility}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.Value}" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubText}" Style="{StaticResource T.Caption}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <ProgressBar Style="{StaticResource Meter}" Height="3" Maximum="100"
                                     Value="{Binding Share, Mode=OneWay}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" Style="{StaticResource T.Value}"
                               Foreground="{Binding CpuBrush}" FontSize="12.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Grid Grid.Column="3">
                        <TextBlock x:Name="MemoryText" Text="{Binding MemoryText}" Style="{StaticResource T.Value}"
                                   Foreground="{StaticResource Br.TextSecondary}" FontSize="12.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button x:Name="RowKill" Content="Finalizar" Style="{StaticResource BtnDanger}"
                                Padding="11,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="Collapsed" Click="RowKill_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter TargetName="RowKill" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="MemoryText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Fila de un proceso suelto, dentro de la ficha de la derecha -->
        <DataTemplate x:Key="PidRowTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PidText}" Style="{StaticResource T.Mono}"
                           Foreground="{StaticResource Br.TextTertiary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource T.Caption}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="{Binding Tip}"/>
                <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Style="{StaticResource T.Value}"
                           FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,24,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ Cabecera ══════════ -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Procesos" Style="{StaticResource T.Title}"/>
                <TextBlock Text="Todo lo que se está ejecutando ahora mismo, también lo que no se ve."
                           Style="{StaticResource T.Secondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" Margin="0,0,7,0">
                    <TextBlock x:Name="CountChip" Text="—" Style="{StaticResource ChipText}"/>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,7,0">
                    <TextBlock x:Name="CpuChip" Text="—" Style="{StaticResource ChipText}"/>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <TextBlock x:Name="RamChip" Text="—" Style="{StaticResource ChipText}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══════════ Buscador, filtros y orden ══════════ -->
        <Grid Grid.Row="1" Margin="0,20,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Height="34"
                     TextChanged="Search_Changed" ToolTip="Buscar por nombre, editor, servicio o PID"/>
            <TextBlock Text="Buscar un programa o proceso…" Style="{StaticResource T.Caption}"
                       Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       x:Name="SearchHint"/>

            <Border Grid.Column="1" Style="{StaticResource Segmented}" HorizontalAlignment="Left"
                    Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Content="Todos" GroupName="ProcFilter"
                                 Style="{StaticResource FilterChip}" IsChecked="True" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterApps" Content="Aplicaciones" GroupName="ProcFilter"
                                 Style="{StaticResource FilterChip}" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterBackground" Content="En segundo plano" GroupName="ProcFilter"
                                 Style="{StaticResource FilterChip}" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterWindows" Content="De Windows" GroupName="ProcFilter"
                                 Style="{StaticResource FilterChip}" Checked="Filter_Changed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SortMemory" Content="Memoria" GroupName="ProcSort"
                                 Style="{StaticResource FilterChip}" IsChecked="True" Checked="Filter_Changed"/>
                    <RadioButton x:Name="SortCpu" Content="Procesador" GroupName="ProcSort"
                                 Style="{StaticResource FilterChip}" Checked="Filter_Changed"/>
                    <RadioButton x:Name="SortName" Content="Nombre" GroupName="ProcSort"
                                 Style="{StaticResource FilterChip}" Checked="Filter_Changed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════ Lista y ficha ══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="24,16,26,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="116"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Programa" Style="{StaticResource T.Label}"/>
                        <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource T.Label}"
                                   HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="3" Text="Memoria" Style="{StaticResource T.Label}"
                                   HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Divider}" Margin="20,0,20,2"/>

                    <Grid>
                        <ListBox x:Name="RowsList" Style="{StaticResource SelectList}"
                                 ItemTemplate="{StaticResource ProcessRowTemplate}"
                                 Margin="14,2,10,10"
                                 SelectionChanged="Rows_SelectionChanged"/>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource T.Secondary}"
                                   Foreground="{StaticResource Br.TextTertiary}" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                   Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Ficha del programa seleccionado -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <TextBlock x:Name="DetailHint" Style="{StaticResource T.Secondary}"
                               Foreground="{StaticResource Br.TextTertiary}" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="28"
                               Text="Elige un programa de la lista para ver sus procesos, cuánta memoria usa cada uno y de dónde sale."/>

                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed" Padding="20,18,16,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="12"
                                        Background="{StaticResource Br.AccentTint}" Margin="0,0,12,0">
                                    <Grid>
                                        <Image x:Name="DetailImage" Width="32" Height="32"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Path x:Name="DetailGlyph" Data="{StaticResource Glyph.Stack}"
                                              Fill="{StaticResource Br.TextTertiary}" Width="22" Height="22"
                                              Stretch="Uniform" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailTitle" Style="{StaticResource T.Headline}"
                                               FontSize="15" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailCompany" Style="{StaticResource T.Caption}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="DetailKindChip" Style="{StaticResource Chip}" Margin="0,0,0,12">
                                <TextBlock x:Name="DetailKindText" Style="{StaticResource ChipText}"/>
                            </Border>

                            <TextBlock x:Name="DetailNote" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                       Margin="0,0,0,14" Visibility="Collapsed"/>

                            <StackPanel x:Name="DetailSpecs" Margin="0,0,0,6"/>

                            <TextBlock x:Name="DetailPath" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Br.TextTertiary}" Margin="0,0,0,14"/>

                            <WrapPanel Margin="0,0,0,16">
                                <Button x:Name="KillButton" Style="{StaticResource BtnDestructive}" Padding="14,7"
                                        Margin="0,0,8,8" Click="Kill_Click" Content="Finalizar"/>
                                <Button x:Name="RevealButton" Content="Abrir ubicación"
                                        Style="{StaticResource BtnGhost}" Padding="12,7" Margin="0,0,0,8"
                                        Click="Reveal_Click"/>
                            </WrapPanel>

                            <Border Style="{StaticResource Divider}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="PidHeader" Text="Procesos" Style="{StaticResource T.Label}"
                                       Margin="0,0,0,10"/>
                            <ItemsControl x:Name="PidList" ItemTemplate="{StaticResource PidRowTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource T.Caption}"
                   Margin="2,12,0,0" TextWrapping="Wrap" Text=" "/>
    </Grid>
</UserControl>
