<UserControl x:Class="Barep.Views.PcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Barep.Controls"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,26,30">

            <TextBlock Text="Mi PC" Style="{StaticResource T.Title}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource T.Secondary}" Margin="0,4,0,20"
                       Text="Leyendo las piezas del equipo…"/>

            <!-- Resumen: RAM, almacenamiento, procesador -->
            <UniformGrid x:Name="SummaryGrid" Columns="3" Margin="0,0,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Plano -->
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <Viewbox Stretch="Uniform" MaxHeight="560">
                            <c:PcBlueprint x:Name="Blueprint"/>
                        </Viewbox>
                        <WrapPanel x:Name="Legend" Margin="4,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Detalle de la pieza -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="DetailKind" Style="{StaticResource T.Caption}" Text="Detalle"/>
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource T.Headline}" FontSize="16" Margin="0,4,0,2"
                                   TextWrapping="Wrap" Text="Pasa el ratón por una pieza"/>
                        <TextBlock x:Name="DetailSubtitle" Style="{StaticResource T.Secondary}" Margin="0,0,0,14"
                                   Text="Las ranuras verdes están libres: ahí puedes añadir memoria o un disco."/>
                        <StackPanel x:Name="DetailSpecs"/>
                        <TextBlock x:Name="DetailHint" Style="{StaticResource T.Secondary}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="2,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Disclaimer" Style="{StaticResource T.Caption}" TextWrapping="Wrap" MaxWidth="760"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Button x:Name="ManualButton" Grid.Column="1" Content="Buscar el manual de mi equipo"
                        Style="{StaticResource BtnGhost}" Click="Manual_Click"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
