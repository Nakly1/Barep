<UserControl x:Class="Barep.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,26,30">

            <TextBlock Text="Herramientas" Style="{StaticResource T.Title}"/>
            <TextBlock Text="Mantenimiento del equipo y exportación de datos."
                       Style="{StaticResource T.Secondary}" Margin="0,4,0,22"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Liberar memoria de la aplicación" Style="{StaticResource T.Headline}"
                               Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource T.Secondary}" Margin="0,0,0,18" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="Fuerza al recolector de basura de .NET a devolver al sistema la memoria que ya no usa Barep. No afecta a otros programas."/>
                    <Button x:Name="GcButton" Content="Compactar memoria de Barep"
                            Style="{StaticResource Btn}" HorizontalAlignment="Left"
                            Click="GcButton_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Exportar informe del sistema" Style="{StaticResource T.Headline}"
                               Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource T.Secondary}" Margin="0,0,0,18" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="Un resumen legible de todo el equipo en un archivo de texto. Si lo que buscas es dejar constancia de las piezas antes de llevar el equipo al técnico, usa mejor «Evidencia»: incluye números de serie y permite verificarlos después."/>
                    <Button x:Name="ExportButton" Content="Guardar informe (.txt)"
                            Style="{StaticResource Btn}" HorizontalAlignment="Left"
                            Click="ExportButton_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource T.Caption}"
                       Margin="2,16,0,0" TextWrapping="Wrap" Text=" "/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
