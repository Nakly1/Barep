<UserControl x:Class="Barep.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Fila de la lista de aplicaciones -->
        <DataTemplate x:Key="AppRowTemplate">
            <Border x:Name="RowBd" Background="Transparent" CornerRadius="8" Padding="4,3"
                    Cursor="Hand" ToolTip="{Binding Tip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Visibility="{Binding ImageVisibility}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Path Data="{StaticResource Glyph.Folder}" Fill="{StaticResource Br.GlyphFolder}"
                              Stretch="Uniform" Margin="3" Visibility="{Binding GlyphVisibility}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Value}" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubText}" Style="{StaticResource T.Caption}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource T.Value}"
                               Foreground="{StaticResource Br.TextSecondary}" FontSize="12.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Fila con casilla: restos, datos y caché -->
        <DataTemplate x:Key="CheckItemTemplate">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Check}" HorizontalAlignment="Left"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Value}"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}"
                               Foreground="{StaticResource Br.TextTertiary}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Detail}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource T.Value}"
                           Foreground="{StaticResource Br.TextSecondary}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Fila de la ventana de vínculos -->
        <DataTemplate x:Key="LinkItemTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Data="{Binding Glyph}" Fill="{Binding GlyphBrush}" Width="14" Height="14"
                      Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Value}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="30,24,26,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════ Cabecera ══════════ -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Aplicaciones" Style="{StaticResource T.Title}"/>
                    <TextBlock Text="Todo lo que tienes instalado. Puedes borrar sólo su caché o quitarla del todo."
                               Style="{StaticResource T.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Margin="0,0,7,0">
                        <TextBlock x:Name="CountChip" Text="—" Style="{StaticResource ChipText}"/>
                    </Border>
                    <Button x:Name="ReloadButton" Content="Volver a leer" Style="{StaticResource BtnGhost}"
                            Padding="12,6" Click="Reload_Click"/>
                </StackPanel>
            </Grid>

            <!-- ══════════ Buscador, filtros y orden ══════════ -->
            <Grid Grid.Row="1" Margin="0,20,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Height="34" Padding="11,0"
                         TextChanged="Search_Changed" ToolTip="Buscar por nombre o fabricante"/>
                <TextBlock x:Name="SearchHint" Text="Buscar una aplicación…" Style="{StaticResource T.Caption}"
                           Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

                <Border Grid.Column="1" Style="{StaticResource Segmented}" HorizontalAlignment="Left"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" Content="Todas" GroupName="AppsFilter"
                                     Style="{StaticResource FilterChip}" IsChecked="True" Checked="Filter_Changed"/>
                        <RadioButton x:Name="FilterPrograms" Content="Programas" GroupName="AppsFilter"
                                     Style="{StaticResource FilterChip}" Checked="Filter_Changed"/>
                        <RadioButton x:Name="FilterStore" Content="De la Store" GroupName="AppsFilter"
                                     Style="{StaticResource FilterChip}" Checked="Filter_Changed"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SortSize" Content="Tamaño" GroupName="AppsSort"
                                     Style="{StaticResource FilterChip}" IsChecked="True" Checked="Filter_Changed"/>
                        <RadioButton x:Name="SortName" Content="Nombre" GroupName="AppsSort"
                                     Style="{StaticResource FilterChip}" Checked="Filter_Changed"/>
                        <RadioButton x:Name="SortDate" Content="Fecha" GroupName="AppsSort"
                                     Style="{StaticResource FilterChip}" Checked="Filter_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════ Lista y ficha ══════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="24,16,26,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="104"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Aplicación" Style="{StaticResource T.Label}"/>
                            <TextBlock Grid.Column="2" Text="Tamaño" Style="{StaticResource T.Label}"
                                       HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Divider}" Margin="20,0,20,2"/>

                        <Grid>
                            <ListBox x:Name="RowsList" Style="{StaticResource SelectList}"
                                     ItemTemplate="{StaticResource AppRowTemplate}" Margin="14,2,10,10"
                                     SelectionChanged="Rows_SelectionChanged"/>
                            <TextBlock x:Name="EmptyText" Text="Leyendo las aplicaciones instaladas…"
                                       Style="{StaticResource T.Secondary}"
                                       Foreground="{StaticResource Br.TextTertiary}" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Ficha de la aplicación -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <TextBlock x:Name="DetailHint" Style="{StaticResource T.Secondary}"
                                   Foreground="{StaticResource Br.TextTertiary}" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="28"
                                   Text="Elige una aplicación para ver cuánto ocupa, qué datos guarda y con qué está enlazada."/>

                        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed" Padding="20,18,16,18">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="13"
                                            Background="{StaticResource Br.AccentTint}" Margin="0,0,12,0">
                                        <Grid>
                                            <Image x:Name="DetailImage" Width="36" Height="36"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Path x:Name="DetailGlyph" Data="{StaticResource Glyph.Folder}"
                                                  Fill="{StaticResource Br.GlyphFolder}" Width="26" Height="26"
                                                  Stretch="Uniform" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailTitle" Style="{StaticResource T.Headline}"
                                                   FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="DetailPublisher" Style="{StaticResource T.Caption}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Chip}" Margin="0,0,0,12">
                                    <TextBlock x:Name="DetailOrigin" Style="{StaticResource ChipText}"/>
                                </Border>

                                <StackPanel x:Name="DetailSpecs" Margin="0,0,0,8"/>

                                <TextBlock x:Name="DetailPath" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                           Foreground="{StaticResource Br.TextTertiary}" Margin="0,0,0,14"/>

                                <WrapPanel>
                                    <Button x:Name="CacheButton" Content="Borrar caché"
                                            Style="{StaticResource BtnPrimary}" Padding="14,7" Margin="0,0,8,8"
                                            Click="Cache_Click"/>
                                    <Button x:Name="UninstallButton" Content="Desinstalar por completo"
                                            Style="{StaticResource BtnDestructive}" Padding="14,7" Margin="0,0,8,8"
                                            Click="Uninstall_Click"/>
                                    <Button x:Name="RevealButton" Content="Abrir ubicación"
                                            Style="{StaticResource BtnGhost}" Padding="12,7" Margin="0,0,0,8"
                                            Click="Reveal_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource T.Caption}"
                       Margin="2,12,0,0" TextWrapping="Wrap" Text=" "/>
        </Grid>

        <!-- ══════════ Ventana de revisión (vínculos, restos, caché) ══════════ -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed">
            <Border Background="{StaticResource Br.Backdrop}" MouseLeftButtonDown="Backdrop_Click"/>

            <Border Style="{StaticResource Card}" MaxWidth="600" MinWidth="460" Margin="40"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="22,20,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="11"
                                Background="{StaticResource Br.AccentTint}" Margin="0,0,12,0">
                            <Grid>
                                <Image x:Name="DialogImage" Width="28" Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Path x:Name="DialogGlyph" Data="{StaticResource Glyph.Info}"
                                      Fill="{StaticResource Br.AccentBright}" Width="20" Height="20"
                                      Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DialogTitle" Style="{StaticResource T.Headline}" FontSize="15"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="DialogSubtitle" Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource BtnIcon}" VerticalAlignment="Top"
                                Click="DialogClose_Click" ToolTip="Cerrar">
                            <Path Data="{StaticResource Glyph.Close}" Stroke="{StaticResource Br.TextSecondary}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" Margin="22,0,22,20">
                        <Grid>
                            <TextBlock x:Name="DialogFooter" Style="{StaticResource T.Caption}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="DialogSecondary" Style="{StaticResource BtnGhost}" Padding="14,8"
                                        Margin="0,0,8,0" Click="DialogSecondary_Click" Visibility="Collapsed"/>
                                <Button x:Name="DialogPrimary" Style="{StaticResource BtnDestructive}"
                                        Padding="18,8" Click="DialogPrimary_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="22,0,22,16">
                        <TextBlock x:Name="DialogMessage" Style="{StaticResource T.Body}" TextWrapping="Wrap"
                                   Margin="0,0,0,12" Visibility="Collapsed"/>

                        <ScrollViewer x:Name="DialogLinksScroll" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed" Margin="0,0,0,4">
                            <ItemsControl x:Name="DialogLinks" ItemTemplate="{StaticResource LinkItemTemplate}"/>
                        </ScrollViewer>

                        <ListBox x:Name="DialogChecks" Style="{StaticResource FlatList}"
                                 ItemTemplate="{StaticResource CheckItemTemplate}" MaxHeight="280"
                                 Visibility="Collapsed"/>

                        <StackPanel x:Name="DialogProgress" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBlock x:Name="ProgressText" Style="{StaticResource T.Caption}" Margin="0,0,0,7"/>
                            <ProgressBar x:Name="ProgressMeter" Style="{StaticResource MeterLarge}" Maximum="100"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
